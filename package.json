{
  "name": "research-trade",
  "version": "0.1.0",
  "description": "XAU/USD entry reminder: TradingView webhook receiver with SQLite persistence and Discord alerts (alert-only, no order execution).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "monitor": "tsx --env-file-if-exists=.env src/chart-monitor/main.ts",
    "monitor:once": "tsx --env-file-if-exists=.env src/chart-monitor/main.ts --once",
    "webhook": "tsx --env-file-if-exists=.env src/webhook-cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "commander": "^15.0.0",
    "fastify": "^5.12.8",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
