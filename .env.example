# Copy to .env and fill in. Never commit .env.

# --- Server ---
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# PostgreSQL. `scripts/init-env.sh` fills in a random password for the local docker-compose database.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://research_trade:CHANGE_ME@127.0.0.1:5432/research_trade
# Number of reverse-proxy hops in front of the app (ngrok / cloudflared = 1).
TRUST_PROXY_HOPS=1

# --- Webhook auth ---
# Shared secret that TradingView puts in the alert message body ("token" field).
# Generate one with: openssl rand -hex 24
WEBHOOK_TOKEN=
# Optional: comma-separated source IPs allowed to call the webhook.
# Take the list from TradingView's webhook documentation. Empty = no IP filter.
ALLOWED_IPS=

# --- Accepted signals ---
ALLOWED_SYMBOLS=XAUUSD
ALLOWED_TIMEFRAMES=15
# Reject signals whose candle timestamp is older than this.
MAX_SIGNAL_AGE_MINUTES=60

# --- Forward test: candle ingestion from the MT5 Expert Advisor ---
# Secret sent in the X-Ingest-Token header. Empty = /ingest/bars is disabled.
# Generate one with: openssl rand -hex 24
INGEST_TOKEN=
# Timeframes (minutes) accepted by /ingest/bars.
BAR_TIMEFRAMES=5,15,60

# --- Discord ---
# Channel settings > Integrations > Webhooks > Copy Webhook URL. Keep it private.
DISCORD_WEBHOOK_URL=
DISCORD_MAX_ATTEMPTS=3
DISCORD_BACKOFF_MS=1000
DISPLAY_TIMEZONE=Asia/Jakarta

# --- Chart monitor (npm run monitor): reads signals off TradingView Desktop and posts to Discord ---
# It uses DATABASE_URL, DISCORD_WEBHOOK_URL and DISPLAY_TIMEZONE above (tables chart_signals and
# chart_monitor_state are created by the migrations). TradingView Desktop must be started with
# --remote-debugging-port=9222, with the chart on MONITOR_SYMBOL / MONITOR_TIMEFRAME and the indicator.
CDP_HOST=127.0.0.1
CDP_PORT=9222
MONITOR_SYMBOL=XAUUSD
# Candle length in minutes; has to divide 60 (15, 30, 60).
MONITOR_TIMEFRAME=30
MONITOR_STUDY=XAUUSD Entry Reminder
# Announced signals the database refused wait in this file until the next check copies them in.
MONITOR_FALLBACK_FILE=.monitor-pending.jsonl
# gold = check only while XAU/USD trades (Monday 05:00 to Saturday 05:00 WIB); always = every candle.
MONITOR_MARKET_HOURS=gold
# Seconds to wait after a candle closes before reading the chart (shorter than the candle).
MONITOR_DELAY_SECONDS=60
