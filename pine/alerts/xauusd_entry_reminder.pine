//@version=6
// XAU/USD Entry Reminder (alert-only).
// Detects BUY / SELL candidates from EMA, RSI and MACD on a confirmed candle close and exposes the
// values the backend needs through hidden plots, so the alert message can reference them with
// {{plot("...")}} placeholders. No secrets live in this script: paste the webhook token into the
// alert message in TradingView's alert dialog.
indicator("XAUUSD Entry Reminder", shorttitle = "XAU Entry", overlay = true, max_lines_count = 150, max_labels_count = 100)

GRP_TREND    = "Trend"
GRP_MOMENTUM = "Momentum"
GRP_LEVELS   = "Levels"
GRP_FILTER   = "Filters"
GRP_PLAN     = "Entry helper"

// ── Inputs ────────────────────────────────────────────────────────────────────
emaFastLen    = input.int(9, "EMA fast", minval = 1, group = GRP_TREND)
emaSlowLen    = input.int(21, "EMA slow", minval = 2, group = GRP_TREND)

rsiLen        = input.int(14, "RSI length", minval = 2, group = GRP_MOMENTUM)
rsiBuyMin     = input.float(55.0, "RSI BUY minimum", minval = 0.0, maxval = 100.0, group = GRP_MOMENTUM)
rsiSellMax    = input.float(45.0, "RSI SELL maximum", minval = 0.0, maxval = 100.0, group = GRP_MOMENTUM)
macdFastLen   = input.int(12, "MACD fast", minval = 1, group = GRP_MOMENTUM)
macdSlowLen   = input.int(26, "MACD slow", minval = 2, group = GRP_MOMENTUM)
macdSignalLen = input.int(9, "MACD signal", minval = 1, group = GRP_MOMENTUM)
macdMode      = input.string("Line vs signal", "MACD confirmation", options = ["Line vs signal", "Histogram"], group = GRP_MOMENTUM)

atrLen        = input.int(14, "ATR length", minval = 1, group = GRP_LEVELS)
swingLen      = input.int(10, "Swing lookback (bars)", minval = 2, group = GRP_LEVELS)
atrBufferMult = input.float(0.5, "Stop: ATR buffer beyond the swing", minval = 0.0, step = 0.1, group = GRP_LEVELS)
rr            = input.float(1.5, "Target (R multiple)", minval = 0.5, step = 0.5, group = GRP_LEVELS)

useHtf        = input.bool(true, "Use higher-timeframe trend filter", group = GRP_FILTER)
htfTf         = input.timeframe("60", "Higher timeframe", group = GRP_FILTER)
cooldownBars  = input.int(4, "Cooldown after a signal (bars)", minval = 0, group = GRP_FILTER)

showPlan      = input.bool(true, "Draw entry, stop and target on a signal", group = GRP_PLAN)
qtyOz         = input.float(1.0, "Size in oz for the risk label (0.01 lot = 1 oz)", minval = 0.01, group = GRP_PLAN)
riskBudgetUsd = input.float(2.5, "Risk budget per trade (USD, warning only)", minval = 0.01, step = 0.25, group = GRP_PLAN)
drawBars      = input.int(1500, "Draw the helper only on the last N bars (0 = all)", minval = 0, group = GRP_PLAN, tooltip = "Drawing for every signal in the whole history is the slow part of this script. TradingView keeps only about the last 50 signals anyway. Signals and alerts are not affected.")

// ── Indicators ────────────────────────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, macdFastLen, macdSlowLen, macdSignalLen)
atr       = ta.atr(atrLen)
swingLow  = ta.lowest(low, swingLen)
swingHigh = ta.highest(high, swingLen)

// Higher-timeframe trend from the last CLOSED higher-timeframe bar: [1] with lookahead_on is the
// standard non-repainting pattern, so the value never changes while the lower-timeframe bar forms.
htfTrendExpr() =>
    fast = ta.ema(close, emaFastLen)
    slow = ta.ema(close, emaSlowLen)
    fast > slow ? 1 : fast < slow ? -1 : 0

htfRaw    = request.security(syminfo.tickerid, htfTf, htfTrendExpr()[1], lookahead = barmerge.lookahead_on)
// The filter only makes sense when the chart runs below the higher timeframe; otherwise it is off.
htfActive = useHtf and timeframe.in_seconds() < timeframe.in_seconds(htfTf)
htfTrend  = htfActive ? nz(htfRaw) : 0

// ── Rules ─────────────────────────────────────────────────────────────────────
macdBull = macdMode == "Line vs signal" ? macdLine > signalLine : histLine > 0
macdBear = macdMode == "Line vs signal" ? macdLine < signalLine : histLine < 0
htfBull  = not htfActive or htfTrend == 1
htfBear  = not htfActive or htfTrend == -1

buyState  = emaFast > emaSlow and rsi >= rsiBuyMin  and macdBull and htfBull
sellState = emaFast < emaSlow and rsi <= rsiSellMax and macdBear and htfBear

// Edge trigger: fire only on the first confirmed bar where every condition becomes true, then
// stay quiet for the cooldown. Without this, a trend would alert on every candle.
var int lastSignalBar = na
cooldownOver = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
buySignal  = barstate.isconfirmed and buyState  and not buyState[1]  and cooldownOver
sellSignal = barstate.isconfirmed and sellState and not sellState[1] and cooldownOver
if buySignal or sellSignal
    lastSignalBar := bar_index

// ── Entry helper: indicative stop and target (swing +/- ATR buffer, R multiple) ─────
// Measured from the signal candle's close. Information only: the alert still fires without it.
longStop    = swingLow - atrBufferMult * atr
shortStop   = swingHigh + atrBufferMult * atr
longTarget  = close + rr * (close - longStop)
shortTarget = close - rr * (shortStop - close)

var int planDir = 0
var int planBar = na
var float planStop = na
var float planTarget = na
var line entryLine = na
var line stopLine = na
var line targetLine = na
var label stopLabel = na
var label targetLabel = na

// Old history is not drawn: it is the expensive part, and only the latest signals stay on the chart.
drawRecent = drawBars == 0 or bar_index > last_bar_index - drawBars

if showPlan and drawRecent and (buySignal or sellSignal)
    planDir    := buySignal ? 1 : -1
    planBar    := bar_index
    planStop   := buySignal ? longStop : shortStop
    planTarget := buySignal ? longTarget : shortTarget
    riskUsd = math.abs(close - planStop) * qtyOz
    overBudget = riskUsd > riskBudgetUsd
    entryLine  := line.new(bar_index, close, bar_index + 1, close, color = color.new(color.gray, 0), style = line.style_dotted)
    stopLine   := line.new(bar_index, planStop, bar_index + 1, planStop, color = color.red, style = line.style_dashed)
    targetLine := line.new(bar_index, planTarget, bar_index + 1, planTarget, color = color.green, style = line.style_dashed)
    rewardUsd = math.abs(planTarget - close) * qtyOz
    // One small label per level, sitting on its own line: red for the stop, green for the target.
    stopLabel   := label.new(bar_index, planStop, "SL " + str.tostring(planStop, "#") + "  -$" + str.tostring(riskUsd, "#.#")
         + (overBudget ? " (over budget)" : ""),
         style = label.style_label_left, color = color.new(color.red, 25), textcolor = color.white, size = size.tiny)
    targetLabel := label.new(bar_index, planTarget, "TP " + str.tostring(planTarget, "#") + "  +$" + str.tostring(rewardUsd, "#.#"),
         style = label.style_label_left, color = color.new(color.green, 25), textcolor = color.white, size = size.tiny)
else if planDir != 0 and bar_index > planBar
    // Keep the levels extending until price touches one of them. If both are touched in the
    // same candle the stop is assumed to hit first (the cautious reading).
    stopHit   = planDir == 1 ? low <= planStop : high >= planStop
    targetHit = planDir == 1 ? high >= planTarget : low <= planTarget
    line.set_x2(entryLine, bar_index)
    line.set_x2(stopLine, bar_index)
    line.set_x2(targetLine, bar_index)
    if stopHit or targetHit
        if stopHit
            label.set_text(stopLabel, label.get_text(stopLabel) + "  > HIT")
        else
            label.set_text(targetLabel, label.get_text(targetLabel) + "  > HIT")
        planDir := 0

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(emaFast, "EMA Fast", color = color.new(color.yellow, 0))
plot(emaSlow, "EMA Slow", color = color.new(color.blue, 0))
// Hidden from the chart, but visible in the Data Window and usable as alert placeholders.
plot(rsi, "RSI", display = display.data_window)
plot(macdLine, "MACD", display = display.data_window)
plot(signalLine, "MACD Signal", display = display.data_window)
plot(histLine, "MACD Histogram", display = display.data_window)
plot(atr, "ATR", display = display.data_window)
plot(swingLow, "Swing Low", display = display.data_window)
plot(swingHigh, "Swing High", display = display.data_window)
plot(htfTrend, "HTF Trend", display = display.data_window)
plot(longStop, "BUY Stop", display = display.data_window)
plot(longTarget, "BUY Target", display = display.data_window)
plot(shortStop, "SELL Stop", display = display.data_window)
plot(shortTarget, "SELL Target", display = display.data_window)

plotshape(buySignal, "BUY candidate", shape.triangleup, location.belowbar, color.green, size = size.small, text = "BUY")
plotshape(sellSignal, "SELL candidate", shape.triangledown, location.abovebar, color.red, size = size.small, text = "SELL")

// ── Alerts ────────────────────────────────────────────────────────────────────
// Create one alert per condition with "Once Per Bar Close", Webhook URL set, and replace
// PASTE_WEBHOOK_TOKEN_HERE in the message with the value of WEBHOOK_TOKEN from the backend .env.
alertcondition(buySignal, "BUY candidate",
  '{"version":"1.1","token":"PASTE_WEBHOOK_TOKEN_HERE","symbol":"{{ticker}}","timeframe":"{{interval}}","timestamp":"{{time}}","direction":"BUY","price":{{close}},"indicators":{"ema_fast":{{plot("EMA Fast")}},"ema_slow":{{plot("EMA Slow")}},"rsi":{{plot("RSI")}},"macd":{{plot("MACD")}},"macd_signal":{{plot("MACD Signal")}},"macd_histogram":{{plot("MACD Histogram")}},"atr":{{plot("ATR")}}},"levels":{"swing_low":{{plot("Swing Low")}},"swing_high":{{plot("Swing High")}}},"htf":{"trend":{{plot("HTF Trend")}}},"plan":{"stop":{{plot("BUY Stop")}},"target":{{plot("BUY Target")}}}}')

alertcondition(sellSignal, "SELL candidate",
  '{"version":"1.1","token":"PASTE_WEBHOOK_TOKEN_HERE","symbol":"{{ticker}}","timeframe":"{{interval}}","timestamp":"{{time}}","direction":"SELL","price":{{close}},"indicators":{"ema_fast":{{plot("EMA Fast")}},"ema_slow":{{plot("EMA Slow")}},"rsi":{{plot("RSI")}},"macd":{{plot("MACD")}},"macd_signal":{{plot("MACD Signal")}},"macd_histogram":{{plot("MACD Histogram")}},"atr":{{plot("ATR")}}},"levels":{"swing_low":{{plot("Swing Low")}},"swing_high":{{plot("Swing High")}}},"htf":{"trend":{{plot("HTF Trend")}}},"plan":{"stop":{{plot("SELL Stop")}},"target":{{plot("SELL Target")}}}}')
